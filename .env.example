# Application Configuration
APP_NAME="Healthcare Voice Agent"
APP_ENV="development"
DEBUG=true
API_V1_STR="/api/v1"

# Server Configuration
HOST="0.0.0.0"
PORT=8000
WORKERS=2

# CORS Settings
ALLOWED_ORIGINS="http://localhost:3000,https://internexus.tech,https://api.internexus.tech"

# Database Settings (POSTGRES_PASSWORD must match across .env and docker-compose)
POSTGRES_SERVER="postgres"
POSTGRES_PORT=5432
POSTGRES_USER="voiceagent"
POSTGRES_PASSWORD="ChooseAStrongPassword123!"
POSTGRES_DB="voiceagentdb"
DATABASE_URL="postgresql://voiceagent:ChooseAStrongPassword123!@postgres:5432/voiceagentdb"

# Security & Secrets (change all three before production)
SECRET_KEY="generate_a_secure_random_secret_key_here"
VAPI_API_KEY="your_vapi_api_key_here"
VAPI_WEBHOOK_SECRET="whsec_your_webhook_secret_here"
PHI_ENCRYPTION_KEY="fernet_32_byte_base64_encoded_key_here"

# Logging & Monitoring
LOG_LEVEL="INFO"
PROMETHEUS_METRICS_ENABLED=true
